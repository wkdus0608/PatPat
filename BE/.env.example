# PatPat 백엔드 환경 변수 예시.
# 실제 값은 .env 로 복사해서 채웁니다(.env 는 git 에 올라가지 않습니다).
# 서버가 .env 를 직접 읽지는 않으므로, 셸에서 내보내거나(export) 실행 명령 앞에 붙여 쓰세요.
#   예) export $(grep -v '^#' .env | xargs) && .venv/bin/uvicorn app.main:app --reload

# --- AI 공급자: Claude ---------------------------------------------------------
# API 키는 아직 등록하지 않았으므로 비워 둡니다.
# 비어 있어도 서버는 켜지고, AI가 필요한 기능(글 만들기, 영역 추천, AI 수정, 관찰일지 변환)만
# 503 AI_NOT_CONFIGURED 로 답합니다. 직접 수정, 확정, 메모, 조회는 키 없이 동작합니다.
ANTHROPIC_API_KEY=

# anthropic: 실제 Claude 호출 / fake: 키 없이 "[테스트 문장]" 이 붙은 가짜 문장(화면 시연용, 실제 서비스 금지)
PATPAT_AI_PROVIDER=anthropic

# 사용할 모델과 생각 강도(low, medium, high, xhigh, max). 비용·품질을 보며 정합니다.
PATPAT_AI_MODEL=claude-opus-5-5
PATPAT_AI_EFFORT=medium

# 한 번의 응답에서 허용하는 최대 출력 토큰, 한 번의 호출을 기다리는 최대 시간(초)
PATPAT_AI_MAX_TOKENS=16000
PATPAT_AI_TIMEOUT_SECONDS=120

# 서버 쪽 대체 응답(fallback). 비워 두면 지원하는 모델에서만 자동으로 켭니다. true / false
PATPAT_AI_FALLBACKS=

# 알림장을 만들 때 아이별 호출을 동시에 몇 개까지 보낼지
PATPAT_AI_PARALLELISM=4

# --- 규칙 파일 / 작업 -----------------------------------------------------------
# 규칙 md 폴더. 비워 두면 BE/rules 를 씁니다.
PATPAT_RULES_PATH=

# true 면 오래 걸리는 작업을 요청 안에서 끝까지 실행합니다(테스트용). 운영에서는 false.
PATPAT_JOBS_INLINE=false
