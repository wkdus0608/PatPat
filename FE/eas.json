{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "node": "24.22.1",
      "pnpm": "11.25.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://patpat-demo-1110.eastasia.cloudapp.azure.com"
      },
      "android": { "buildType": "apk" }
    }
  }
}
